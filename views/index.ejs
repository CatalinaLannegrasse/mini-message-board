<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="container">
      <header class="wa-topbar">
        <h1><%= title %></h1>
        <a class="btn" href="/new">+ New Message</a>
      </header>

      <section class="wa-chat-panel">
        <ul class="message-list">
          <% messages.forEach((message, index) => { %>
            <li class="message-bubble <%= index % 2 === 1 ? 'message-bubble--alt' : '' %>">
              <span class="message-author"><%= message.user %></span>
              <p class="message-text"><%= message.text %></p>
              <div class="message-meta">
                <span class="message-date"><%= message.added.toLocaleString() %></span>
                <a class="btn btn-secondary" href="/messages/<%= message.id %>">Open</a>
              </div>
            </li>
          <% }) %>
        </ul>
      </section>
    </main>
  </body>
</html>