<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="container">
      <header class="wa-topbar">
        <h1><%= title %></h1>
        <a class="btn" href="/">Back</a>
      </header>

      <section class="wa-chat-panel">
        <form class="message-form" method="POST" action="/new">
          <div class="field">
            <label for="messageUser">Author</label>
            <input
              type="text"
              id="messageUser"
              name="messageUser"
              placeholder="Your name"
              required
            />
          </div>

          <div class="field">
            <label for="messageText">Message</label>
            <input
              type="text"
              id="messageText"
              name="messageText"
              placeholder="Type a message..."
              required
            />
          </div>

          <div class="actions">
            <button class="btn" type="submit">Send</button>
            <a class="btn btn-secondary" href="/">Cancel</a>
          </div>
        </form>
      </section>
    </main>
  </body>
</html>