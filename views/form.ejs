<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="container">
      <header class="wa-topbar">
        <h1><%= title %></h1>
        <a class="btn" href="/">Back</a>
      </header>

      <% if (locals.errors && errors.length > 0) { %>
        <ul class="error-list">
          <% errors.forEach((error) => { %>
            <li><%= error.msg %></li>
          <% }) %>
        </ul>
      <% } %>

      <form class="message-form" method="POST" action="/new">
        <div class="field">
          <label for="messageUser">Author</label>
          <input
            type="text"
            id="messageUser"
            name="messageUser"
            value="<%= locals.formData ? formData.messageUser : '' %>"
            required
          />
        </div>

        <div class="field">
          <label for="messageText">Message</label>
          <input
            type="text"
            id="messageText"
            name="messageText"
            value="<%= locals.formData ? formData.messageText : '' %>"
            required
          />
        </div>

        <div class="actions">
          <button class="btn" type="submit">Send</button>
          <a class="btn btn-secondary" href="/">Cancel</a>
        </div>
      </form>
    </main>
  </body>
</html>